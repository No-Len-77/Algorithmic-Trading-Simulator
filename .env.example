# =============================================================================
# Environment template — copy to `.env` and edit. `.env` is gitignored.
#
# Every key below maps to a field on `Settings` in app/core/config.py, which is
# the single source of truth. Keys are case-insensitive. Anything not listed
# there is ignored (`extra="ignore"`), so a typo fails silently — check against
# config.py, not against memory.
#
# ---------------------------------------------------------------------------
# TWO RULES THAT WILL STOP THE APP FROM BOOTING IF YOU GET THEM WRONG
# ---------------------------------------------------------------------------
#
# 1. DATABASE_URL must use the SYNC scheme: `postgresql://`
#    The app builds BOTH engines from this one value — it derives the async URL
#    itself via `Settings.database_url_async`. Writing `postgresql+asyncpg://`
#    here breaks the sync engine and Alembic.
#        GOOD  postgresql://user:pass@host:5432/dbname
#        BAD   postgresql+asyncpg://user:pass@host:5432/dbname
#    (`postgres://`, which managed providers emit, is auto-coerced. That's fine.)
#
# 2. List-valued vars are JSON arrays, NOT comma-separated.
#    Affects ALLOWED_HOSTS, CORS_ORIGINS, CORS_ALLOW_METHODS, CORS_ALLOW_HEADERS.
#        GOOD  ALLOWED_HOSTS=["a.example.com","b.example.com"]
#        BAD   ALLOWED_HOSTS=a.example.com,b.example.com
#    The bad form raises SettingsError at import time — the process never starts.
#
# 3. Avoid a literal `%` in the database password. Alembic passes the URL
#    through ConfigParser, which treats `%` as interpolation syntax.
# =============================================================================


# -----------------------------------------------------------------------------
# Application identity
# -----------------------------------------------------------------------------
ENVIRONMENT=development          # development | test | staging | production
DEBUG=false
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_JSON=false                   # set true in production for structured logs


# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# WORKERS is intentionally 1 and should stay 1.
# The market / candle / signal / stream / equity-snapshot engines run inside the
# FastAPI lifespan (main.py), and the auth rate limiter is an in-process dict
# (app/core/rate_limit.py). N workers means N duplicate engines writing to the
# same tables and an effective rate limit of N x the configured value.
# Scale vertically, or extract the engines to their own process first.
WORKERS=1


# -----------------------------------------------------------------------------
# Security — TrustedHostMiddleware (production only). JSON array.
# Rejects requests with an unexpected Host header.
# -----------------------------------------------------------------------------
ALLOWED_HOSTS=["localhost","127.0.0.1"]


# -----------------------------------------------------------------------------
# CORS — JSON arrays.
#
# Only needed when the SPA is served from a DIFFERENT origin than the API. In
# the same-origin deployments (local Vite proxy, the Render image, and the AWS
# CloudFront setup where one distribution fronts both S3 and EC2) this can stay
# at the dev defaults, because the browser never makes a cross-origin request.
# -----------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
CORS_ALLOW_CREDENTIALS=true


# -----------------------------------------------------------------------------
# Database  (see rule 1 above)
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite:///./hft.db
# DATABASE_URL=postgresql://hft_user:hft_password@localhost:5432/hft_db

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_PRE_PING=true
DATABASE_ECHO=false

# Seconds startup will keep retrying the database before giving up. A managed
# instance that is restarting or waking from idle can refuse connections for
# tens of seconds; without a wait, the first probe fails and the platform marks
# the whole service failed. 0 = probe once (previous behaviour).
DATABASE_STARTUP_TIMEOUT=90


# -----------------------------------------------------------------------------
# Redis
#
# USE_FAKE_REDIS runs an in-process fakeredis so the app needs zero external
# infra locally. It is NEVER honoured in production — a missing token store
# there is a real outage, so startup fails fast instead.
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
USE_FAKE_REDIS=true
REDIS_CACHE_TTL=300


# -----------------------------------------------------------------------------
# Auth  *** SECRET ***
#
# JWT_SECRET_KEY must be >= 32 chars and must not contain "change-me" when
# ENVIRONMENT=production — a field validator rejects it and the app won't start.
# Generate with:  openssl rand -hex 32
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_DAYS=7
JWT_WS_TTL_SECONDS=60
JWT_AUDIENCE=hft-platform

PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_SPECIAL=false


# -----------------------------------------------------------------------------
# Rate limiting (per client IP)
# -----------------------------------------------------------------------------
API_RATE_LIMIT=100
AUTH_RATE_LIMIT=5
REQUEST_TIMEOUT_SECONDS=10


# -----------------------------------------------------------------------------
# Market data
#
# USE_SYNTHETIC_MARKET=true serves a deterministic 24/7 synthetic market, so
# prices never depend on exchange hours or a provider's rate limits. This is the
# right setting for a demo and for reproducible load tests.
# -----------------------------------------------------------------------------
USE_SYNTHETIC_MARKET=true
MARKET_DATA_REFRESH_INTERVAL=2
MARKET_DATA_CACHE_TTL=5
MAX_SYMBOLS=50
EQUITY_SNAPSHOT_INTERVAL=15

# Optional provider keys *** SECRET IF SET ***. Unset => synthetic provider.
# ALPHA_VANTAGE_API_KEY=
# POLYGON_API_KEY=


# -----------------------------------------------------------------------------
# WebSocket
# -----------------------------------------------------------------------------
WEBSOCKET_ENABLED=true
WEBSOCKET_MAX_CONNECTIONS=1000
WEBSOCKET_HEARTBEAT_INTERVAL=30
WEBSOCKET_HEARTBEAT_TIMEOUT=10
WEBSOCKET_MAX_MESSAGE_BYTES=64000


# -----------------------------------------------------------------------------
# Trading / risk
# -----------------------------------------------------------------------------
TRADING_ENABLED=true
MAX_POSITION_SIZE=10000.0
MAX_DAILY_LOSS=5000.0
MAX_CONCURRENT_TRADES=50
CONCENTRATION_LIMIT=0.30

RISK_CHECK_INTERVAL=30
STOP_LOSS_PERCENTAGE=0.05
TAKE_PROFIT_PERCENTAGE=0.10


# -----------------------------------------------------------------------------
# Signals / ML
# -----------------------------------------------------------------------------
SIGNAL_UPDATE_INTERVAL=10
MODEL_UPDATE_INTERVAL=3600
MODEL_LOAD_ON_STARTUP=false
PREDICTION_CONFIDENCE_THRESHOLD=0.7
